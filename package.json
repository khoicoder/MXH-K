{
  "name": "enterprise-social-network",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Ready Microservices Social Network Platform",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:server": "ts-node -r tsconfig-paths/register apps/api-gateway/src/main.ts",
    "dev:gateway": "ts-node -r tsconfig-paths/register apps/api-gateway/src/main.ts",
    "dev:auth": "ts-node -r tsconfig-paths/register apps/auth-service/src/main.ts",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:status": "docker compose -f infra/docker-compose.yml ps",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "jest": "^30.5.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "socket.io": "^4.8.1"
  }
}
