generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("USER_DATABASE_URL")
}

model UserProfile {
  userId      String    @id
  username    String    @unique
  displayName String
  avatarUrl   String?
  coverUrl    String?
  bio         String?
  gender      String?
  birthdate   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  settings    UserSettings?

  @@index([username])
  @@map("user_profiles")
}

model UserSettings {
  userId                String      @id
  postVisibilityDefault String      @default("PUBLIC")
  allowFriendRequests   Boolean     @default(true)
  isPrivateAccount      Boolean     @default(false)
  updatedAt             DateTime    @updatedAt

  profile               UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_settings")
}
