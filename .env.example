# Node Environment
NODE_ENV=development

# API Gateway
GATEWAY_PORT=3000
FRONTEND_URL=http://localhost:3000

# Auth Service
AUTH_PORT=3001
AUTH_SERVICE_URL=http://localhost:3001
AUTH_DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/auth_db?schema=public

# User Service
USER_PORT=3002
USER_SERVICE_URL=http://localhost:3002
USER_DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/user_db?schema=public

# Social Graph Service
SOCIAL_PORT=3003
SOCIAL_SERVICE_URL=http://localhost:3003
SOCIAL_DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/social_db?schema=public

# Post Service
POST_PORT=3004
POST_SERVICE_URL=http://localhost:3004
POST_DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/post_db?schema=public

# Interaction Service
INTERACT_PORT=3005
INTERACTION_SERVICE_URL=http://localhost:3005
INTERACTION_DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/interact_db?schema=public

# Feed Service
FEED_PORT=3006
FEED_SERVICE_URL=http://localhost:3006
FEED_DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/feed_db?schema=public

# Media Service
MEDIA_PORT=3007
MEDIA_SERVICE_URL=http://localhost:3007
MEDIA_DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/media_db?schema=public
S3_ENDPOINT=http://localhost:9090
S3_BUCKET=mxh-media

# Reels Service
REELS_PORT=3008
REELS_SERVICE_URL=http://localhost:3008
REELS_DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/reels_db?schema=public

# Notification Service
NOTIF_PORT=3009
NOTIF_SERVICE_URL=http://localhost:3009
NOTIF_DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/notif_db?schema=public

# Search Service
SEARCH_PORT=3010
SEARCH_SERVICE_URL=http://localhost:3010
SEARCH_DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/search_db?schema=public

# Redis Cluster / Instance
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis_secure_pass

# RabbitMQ
RABBITMQ_URL=amqp://rabbit_admin:rabbit_secure_pass@localhost:5672

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
